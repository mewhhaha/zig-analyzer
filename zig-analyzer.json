{
  "check": {
    "exclude": ["examples/diagnostics", "fixtures/projects"]
  },
  "contracts": {
    "arena-allocators": [
      "RuleRun.allocator",
      "ProjectRun.allocator",
      "ActionRun.allocator",
      "findingsWith.allocator",
      "findingsFromTokens.allocator",
      "parse.allocator",
      "describeIdentifier.allocator",
      "standardLibraryMember.allocator",
      "copyResolvedShapes.allocator",
      "forFinding.allocator",
      "extractExpression.allocator",
      "moveCleanupAfterAcquisition.allocator",
      "reflectionStringSpans.allocator"
    ],
    "imports": [
      {
        "from": "src/syntax",
        "deny": ["src/lsp", "src/compiler", "src/project", "src/rules", "src/actions"]
      },
      {
        "from": "src/rules",
        "deny": ["src/lsp", "src/compiler", "src/project"]
      },
      {
        "from": "src/actions",
        "deny": ["src/lsp", "src/compiler", "src/project"]
      },
      {
        "from": "src/compiler",
        "deny": ["src/lsp", "src/project", "src/actions"]
      },
      {
        "from": "src/project",
        "deny": ["src/lsp"]
      }
    ]
  },
  "lints": {
    "profile": "idiomatic",
    "correctness": "warning",
    "rules": {
      "discarded-error": "warning",
      "literal-boolean-argument": "information",
      "modernize-managed-container": "warning",
      "modernize-deprecated-io": "warning",
      "modernize-deprecated-stdlib": "warning",
      "modernize-deprecated-builtin": "warning",
      "modernize-removed-syntax": "warning",
      "modernize-build-api": "warning",
      "modernize-bitcast": "warning",
      "modernize-extern-bitcast": "warning",
      "modernize-global-linkage": "warning",
      "modernize-array-list-access": "warning",
      "modernize-container-init": "warning",
      "lost-error-context": "warning",
      "unsafe-orelse-unreachable": "warning",
      "unsafe-catch-unreachable": "warning",
      "vague-type-name": "warning",
      "error-collapsed-to-absence": "warning"
    }
  }
}
