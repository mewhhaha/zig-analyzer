new file mode 100644
index 00000000..f7bad1db
--- /dev/null
+++ b/src/AnalysisSymbols.zig
@@ -0,0 +1,393 @@
+//! Answers the analyzer's `resolve_symbol` queries: evaluates a member-access
+//! path against the declarations the compiler resolved (type declarations,
+//! aliases, imports, method return types, field types) and reports the source
+//! name token of the declaration or field a name denotes. Evaluation is lazy
+//! and syntax-driven: it needs no analysis of function bodies, so code the
+//! compile never reached resolves too. Anything it cannot evaluate yields a
+//! status instead of an identity.
+const std = @import("std");
+const Ast = std.zig.Ast;
+
+const AnalysisProtocol = @import("AnalysisProtocol.zig");
+const InternPool = @import("InternPool.zig");
+const Type = @import("Type.zig");
+const Zcu = @import("Zcu.zig");
+
+const Resolver = @This();
+
+zcu: *Zcu,
+pt: Zcu.PerThread,
+scope: [max_scope_depth]InternPool.Index = undefined,
+scope_len: usize = 0,
+
+const max_scope_depth = 32;
+const max_steps = 64;
+
+pub const Symbol = struct {
+    status: AnalysisProtocol.SymbolStatus,
+    kind: AnalysisProtocol.SymbolKind = .none,
+    file: ?*Zcu.File = null,
+    start: u32 = 0,
+    end: u32 = 0,
+};
+
+const Fail = error{ Unresolved, Absent, Generic, OutOfMemory, Canceled };
+
+/// What the steps evaluated so far produced.
+const Value = union(enum) {
+    /// Nothing yet: the next name is looked up lexically.
+    none,
+    /// A type, used as a namespace.
+    type: InternPool.Index,
+    /// An expression of this type.
+    instance: InternPool.Index,
+    /// A declared function.
+    function: InternPool.Nav.Index,
+};
+
+const Step = struct {
+    kind: AnalysisProtocol.StepKind,
+    name: []const u8,
+};
+
+/// Reads the query at `offset.*` of `bytes`, advances past it, and resolves it
+/// in the file `file_index`.
+pub fn resolve(
+    resolver: *Resolver,
+    file_index: Zcu.File.Index,
+    bytes: []const u8,
+    offset: *usize,
+) error{ MalformedQuery, OutOfMemory, Canceled }!Symbol {
+    if (bytes.len - offset.* < @sizeOf(AnalysisProtocol.QueryHeader)) return error.MalformedQuery;
+    const flags = std.mem.readInt(u16, bytes[offset.*..][0..2], .little);
+    const step_count = std.mem.readInt(u16, bytes[offset.* + 2 ..][0..2], .little);
+    offset.* += @sizeOf(AnalysisProtocol.QueryHeader);
+
+    var steps: [max_steps]Step = undefined;
+    var kept: usize = 0;
+    for (0..step_count) |_| {
+        if (bytes.len - offset.* < @sizeOf(AnalysisProtocol.Step)) return error.MalformedQuery;
+        const kind: AnalysisProtocol.StepKind = @fromBackingInt(bytes[offset.*]);
+        const name_length = std.mem.readInt(u16, bytes[offset.* + 2 ..][0..2], .little);
+        offset.* += @sizeOf(AnalysisProtocol.Step);
+        if (bytes.len - offset.* < name_length) return error.MalformedQuery;
+        if (kept < max_steps) {
+            steps[kept] = .{ .kind = kind, .name = bytes[offset.*..][0..name_length] };
+            kept += 1;
+        }
+        offset.* += name_length;
+    }
+    if (step_count > max_steps) return .{ .status = .unresolved };
+    return resolver.evaluate(file_index, flags, steps[0..kept]) catch |err| switch (err) {
+        error.Unresolved => .{ .status = .unresolved },
+        error.Absent => .{ .status = .absent },
+        error.Generic => .{ .status = .generic },
+        error.OutOfMemory => error.OutOfMemory,
+        error.Canceled => error.Canceled,
+    };
+}
+
+fn evaluate(resolver: *Resolver, file_index: Zcu.File.Index, flags: u16, steps: []const Step) Fail!Symbol {
+    var root = resolver.zcu.fileRootType(file_index);
+    if (root == .none) {
+        // Nothing the compile reached imported the file yet, but it is part of
+        // the compile: populate its root container so its declarations exist.
+        const file = resolver.zcu.fileByIndex(file_index);
+        if (file.zir == null or file.getMode() != .zig) return error.Unresolved;
+        resolver.pt.ensureFilePopulated(file_index) catch |err| switch (err) {
+            error.OutOfMemory => return error.OutOfMemory,
+            error.Canceled => return error.Canceled,
+        };
+        root = resolver.zcu.fileRootType(file_index);
+        if (root == .none) return error.Unresolved;
+    }
+    resolver.scope[0] = root;
+    resolver.scope_len = 1;
+
+    var current: Value = .none;
+    for (steps, 0..) |step, index| {
+        switch (step.kind) {
+            .scope => {
+                if (current != .none) return error.Unresolved;
+                const nav = resolver.findDeclaration(resolver.scope[resolver.scope_len - 1], step.name) orelse return error.Unresolved;
+                switch (try resolver.navValue(nav)) {
+                    .type => |container| {
+                        if (resolver.scope_len == max_scope_depth) return error.Unresolved;
+                        resolver.scope[resolver.scope_len] = container;
+                        resolver.scope_len += 1;
+                    },
+                    else => return error.Unresolved,
+                }
+            },
+            .name => current = try resolver.stepName(current, step.name),
+            .call => current = try resolver.stepCall(current),
+            .index => current = try resolver.stepIndex(current),
+            .target => {
+                if (index + 1 != steps.len) return error.Unresolved;
+                return resolver.target(current, flags & AnalysisProtocol.query_declaration_site != 0, step.name);
+            },
+            _ => return error.Unresolved,
+        }
+    }
+    return error.Unresolved;
+}
+
+fn target(resolver: *Resolver, current: Value, declaration_site: bool, name: []const u8) Fail!Symbol {
+    if (declaration_site) {
+        if (current != .none) return error.Unresolved;
+        return resolver.member(resolver.scope[resolver.scope_len - 1], name);
+    }
+    switch (current) {
+        .none => {
+            var depth = resolver.scope_len;
+            while (depth > 0) {
+                depth -= 1;
+                if (resolver.findDeclaration(resolver.scope[depth], name)) |nav| return resolver.navSymbol(nav);
+            }
+            return error.Unresolved;
+        },
+        .type => |container| return resolver.member(resolver.peel(container), name),
+        .instance => |container| return resolver.member(resolver.peel(container), name),
+        .function => return error.Unresolved,
+    }
+}
+
+/// The declaration or field `name` of the container type `container`.
+fn member(resolver: *Resolver, container: InternPool.Index, name: []const u8) Fail!Symbol {
+    if (!resolver.isContainer(container)) return error.Unresolved;
+    if (resolver.findDeclaration(container, name)) |nav| return resolver.navSymbol(nav);
+    return (try resolver.fieldSymbol(container, name)) orelse error.Absent;
+}
+
+fn isContainer(resolver: *Resolver, ty: InternPool.Index) bool {
+    return switch (resolver.zcu.intern_pool.indexToKey(ty)) {
+        .struct_type, .union_type, .enum_type, .opaque_type => true,
+        else => false,
+    };
+}
+
+fn stepName(resolver: *Resolver, current: Value, name: []const u8) Fail!Value {
+    switch (current) {
+        .none => {
+            var depth = resolver.scope_len;
+            while (depth > 0) {
+                depth -= 1;
+                if (resolver.findDeclaration(resolver.scope[depth], name)) |nav| return resolver.navValue(nav);
+            }
+            return error.Unresolved;
+        },
+        .type => |container| return resolver.memberValue(resolver.peel(container), name),
+        .instance => |container| return resolver.memberValue(resolver.peel(container), name),
+        .function => return error.Unresolved,
+    }
+}
+
+fn memberValue(resolver: *Resolver, container: InternPool.Index, name: []const u8) Fail!Value {
+    if (!resolver.isContainer(container)) return error.Unresolved;
+    if (resolver.findDeclaration(container, name)) |nav| return resolver.navValue(nav);
+    return .{ .instance = try resolver.fieldType(container, name) };
+}
+
+fn stepCall(resolver: *Resolver, current: Value) Fail!Value {
+    const nav_index = switch (current) {
+        .function => |nav| nav,
+        else => return error.Unresolved,
+    };
+    const ip = &resolver.zcu.intern_pool;
+    const resolved = ip.getNav(nav_index).resolved orelse return error.Unresolved;
+    const func_type = switch (ip.indexToKey(resolved.type)) {
+        .func_type => |func_type| func_type,
+        else => return error.Unresolved,
+    };
+    if (func_type.return_type == .generic_poison_type or func_type.return_type == .type_type) return error.Generic;
+    return .{ .instance = func_type.return_type };
+}
+
+fn stepIndex(resolver: *Resolver, current: Value) Fail!Value {
+    const ip = &resolver.zcu.intern_pool;
+    var ty = switch (current) {
+        .instance => |ty| ty,
+        else => return error.Unresolved,
+    };
+    while (true) switch (ip.indexToKey(ty)) {
+        .ptr_type => |pointer| {
+            if (pointer.flags.size != .one) return .{ .instance = pointer.child };
+            ty = pointer.child;
+        },
+        .opt_type => |child| ty = child,
+        .array_type => |array| return .{ .instance = array.child },
+        .vector_type => |vector| return .{ .instance = vector.child },
+        else => return error.Unresolved,
+    };
+}
+
+/// Strips single-item pointers, optionals, and error unions: the type member
+/// access looks into.
+fn peel(resolver: *Resolver, start: InternPool.Index) InternPool.Index {
+    const ip = &resolver.zcu.intern_pool;
+    var ty = start;
+    while (true) switch (ip.indexToKey(ty)) {
+        .ptr_type => |pointer| {
+            if (pointer.flags.size != .one) return ty;
+            ty = pointer.child;
+        },
+        .opt_type => |child| ty = child,
+        .error_union_type => |error_union| ty = error_union.payload_type,
+        else => return ty,
+    };
+}
+
+/// The declaration of `container` named `name`, if the container has one.
+fn findDeclaration(resolver: *Resolver, container: InternPool.Index, name: []const u8) ?InternPool.Nav.Index {
+    const zcu = resolver.zcu;
+    const ip = &zcu.intern_pool;
+    if (!resolver.isContainer(container)) return null;
+    // A union's generated tag enum has no namespace.
+    const namespace_index = Type.fromInterned(container).getNamespace(zcu).unwrap() orelse return null;
+    const namespace = zcu.namespacePtr(namespace_index);
+    for (namespace.pub_decls.keys()) |nav_index| {
+        if (std.mem.eql(u8, ip.getNav(nav_index).name.toSlice(ip), name)) return nav_index;
+    }
+    for (namespace.priv_decls.keys()) |nav_index| {
+        if (std.mem.eql(u8, ip.getNav(nav_index).name.toSlice(ip), name)) return nav_index;
+    }
+    return null;
+}
+
+/// What a declaration is: resolves its value if that has not happened yet.
+fn navValue(resolver: *Resolver, nav_index: InternPool.Nav.Index) Fail!Value {
+    const zcu = resolver.zcu;
+    const ip = &zcu.intern_pool;
+    var nav = ip.getNav(nav_index);
+    if (nav.resolved == null or nav.resolved.?.value == .none) {
+        resolver.pt.ensureNavValUpToDate(nav_index, null) catch |err| switch (err) {
+            error.AnalysisFail => return error.Unresolved,
+            error.OutOfMemory => return error.OutOfMemory,
+            error.Canceled => return error.Canceled,
+        };
+        nav = ip.getNav(nav_index);
+    }
+    const resolved = nav.resolved orelse return error.Unresolved;
+    return switch (Type.fromInterned(resolved.type).zigTypeTag(zcu)) {
+        .type => if (resolved.value == .none) error.Unresolved else .{ .type = resolved.value },
+        .@"fn" => .{ .function = nav_index },
+        else => .{ .instance = resolved.type },
+    };
+}
+
+/// The type of the field `name` of `container`.
+fn fieldType(resolver: *Resolver, container: InternPool.Index, name: []const u8) Fail!InternPool.Index {
+    const ip = &resolver.zcu.intern_pool;
+    switch (ip.indexToKey(container)) {
+        .enum_type => {
+            const loaded = ip.loadEnumType(container);
+            for (loaded.field_names.get(ip)) |field_name| {
+                if (std.mem.eql(u8, field_name.toSlice(ip), name)) return container;
+            }
+            return error.Absent;
+        },
+        .struct_type => {
+            try resolver.ensureLayout(container);
+            const loaded = ip.loadStructType(container);
+            for (loaded.field_names.get(ip), loaded.field_types.get(ip)) |field_name, field_type| {
+                if (std.mem.eql(u8, field_name.toSlice(ip), name)) return usable(field_type);
+            }
+            return error.Absent;
+        },
+        .union_type => {
+            try resolver.ensureLayout(container);
+            const loaded = ip.loadUnionType(container);
+            if (loaded.tag_usage != .tagged or loaded.enum_tag_type == .none) return error.Unresolved;
+            const tag_names = ip.loadEnumType(loaded.enum_tag_type).field_names.get(ip);
+            for (tag_names, loaded.field_types.get(ip)) |field_name, field_type| {
+                if (std.mem.eql(u8, field_name.toSlice(ip), name)) return usable(field_type);
+            }
+            return error.Absent;
+        },
+        else => return error.Unresolved,
+    }
+}
+
+fn usable(field_type: InternPool.Index) Fail!InternPool.Index {
+    if (field_type == .none or field_type == .generic_poison_type) return error.Generic;
+    return field_type;
+}
+
+fn ensureLayout(resolver: *Resolver, container: InternPool.Index) Fail!void {
+    resolver.pt.ensureTypeLayoutUpToDate(Type.fromInterned(container), null) catch |err| switch (err) {
+        error.AnalysisFail => return error.Unresolved,
+        error.OutOfMemory => return error.OutOfMemory,
+        error.Canceled => return error.Canceled,
+    };
+}
+
+/// The name token of the declaration `nav_index`.
+fn navSymbol(resolver: *Resolver, nav_index: InternPool.Nav.Index) Fail!Symbol {
+    const zcu = resolver.zcu;
+    const source = zcu.navSrcLoc(nav_index).upgradeOrLost(zcu) orelse return error.Unresolved;
+    const tree = source.file_scope.getTree(zcu) catch return error.Unresolved;
+    var buffer: [1]Ast.Node.Index = undefined;
+    const name_token: Ast.TokenIndex = if (tree.fullFnProto(&buffer, source.base_node)) |prototype|
+        prototype.name_token orelse return error.Unresolved
+    else if (tree.fullVarDecl(source.base_node)) |declaration|
+        declaration.ast.mut_token + 1
+    else
+        return error.Unresolved;
+    return tokenSymbol(source.file_scope, tree, name_token, .declaration);
+}
+
+/// The name token of the field `name` of `container`, from the container's
+/// source, or null when it declares no such field.
+fn fieldSymbol(resolver: *Resolver, container: InternPool.Index, name: []const u8) Fail!?Symbol {
+    const zcu = resolver.zcu;
+    const ip = &zcu.intern_pool;
+    const tracked = switch (ip.indexToKey(container)) {
+        .struct_type => ip.loadStructType(container).zir_index,
+        .union_type => ip.loadUnionType(container).zir_index,
+        .enum_type => ip.loadEnumType(container).zir_index.unwrap() orelse return error.Unresolved,
+        .opaque_type => ip.loadOpaqueType(container).zir_index,
+        else => return error.Unresolved,
+    };
+    const resolved = tracked.resolveFull(ip) orelse return error.Unresolved;
+    const file = zcu.fileByIndex(resolved.file);
+    const zir = if (file.zir) |*zir| zir else return error.Unresolved;
+    const instruction = zir.instructions.get(@backingInt(resolved.inst));
+    if (instruction.tag != .extended) return error.Unresolved;
+    const node: Ast.Node.Index = switch (instruction.data.extended.opcode) {
+        .struct_decl => zir.getStructDecl(resolved.inst).src_node,
+        .union_decl => zir.getUnionDecl(resolved.inst).src_node,
+        .enum_decl => zir.getEnumDecl(resolved.inst).src_node,
+        .opaque_decl => zir.getOpaqueDecl(resolved.inst).src_node,
+        else => return error.Unresolved,
+    };
+    const tree = file.getTree(zcu) catch return error.Unresolved;
+    var buffer: [2]Ast.Node.Index = undefined;
+    const members: []const Ast.Node.Index = if (node == .root)
+        tree.rootDecls()
+    else
+        (tree.fullContainerDecl(&buffer, node) orelse return error.Unresolved).ast.members;
+    for (members) |member_node| {
+        const field = tree.fullContainerField(member_node) orelse continue;
+        const name_token = field.ast.main_token;
+        if (tree.tokenTag(name_token) != .identifier) continue;
+        if (!std.mem.eql(u8, tree.tokenSlice(name_token), name)) continue;
+        return tokenSymbol(file, tree, name_token, .field);
+    }
+    return null;
+}
+
+fn tokenSymbol(
+    file: *Zcu.File,
+    tree: *const Ast,
+    token: Ast.TokenIndex,
+    kind: AnalysisProtocol.SymbolKind,
+) Symbol {
+    const start: u32 = tree.tokenStart(token);
+    return .{
+        .status = .resolved,
+        .kind = kind,
+        .file = file,
+        .start = start,
+        .end = start + @as(u32, @intCast(tree.tokenSlice(token).len)),
+    };
+}
