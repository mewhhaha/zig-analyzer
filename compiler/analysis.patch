+                const uri = try stream_reader.readAlloc(ids.zcu.gpa, request.uri_length);
+                defer ids.zcu.gpa.free(uri);
+                const source = try stream_reader.readAlloc(ids.zcu.gpa, request.source_length);
+                defer ids.zcu.gpa.free(source);
+                const file_index = overlayFileIndex(ids, uri) orelse {
+                    try writeErrorResponse(stream_writer, header.request_id, ids.analysis_generation, .unavailable, "document is outside the active compile unit");
+                    continue;
+                };
+                try ids.replaceOverlay(uri, request.document_version, source, file_index);
+                const facts = try ids.documentFacts(uri, request.document_version);
